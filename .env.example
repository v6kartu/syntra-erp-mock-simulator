SYNTRAOS_API_URL=https://api.syntrasystems.cloud
SYNTRAOS_TENANT=
SYNTRAOS_SHOP_KEY=
SYNTRAOS_SHOP_SECRET=
SYNTRAOS_IOT_KEY=
SYNTRAOS_IOT_SECRET=
SYNTRAOS_LINE_ID=
SYNTRAOS_BADGE_TOKEN=BADGE-001
